# ##################################################################################################
#   VSU-API · ASP.NET Core (.NET 10) · backend only · multi-stage · full repo context · non-root
#   Runtime + SDK: Alpine (smaller image, reduced attack surface)
#
#   Build (from repo root, ALWAYS — the context is the repo root so every COPY starts there):
#     docker build -t vsu-api:local -f vsu-app/Dockerfile.api .
#   Run:
#     docker run --rm -it -p 8080:8080 vsu-api:local
#
#   VSU ships its UI as a SEPARATE image (vsu-ui); this image is the .NET API only. The csproj still
#   carries SpaServices targets, so ClientApp is stubbed below to keep them a no-op — no Angular build.
# ##################################################################################################

# --- Runtime base ---
FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine@sha256:f62a272ac1b46e83f56b8ed0416572f31cd1128e2c4a5e63eb34d348e4a36095 AS base
WORKDIR /app
EXPOSE 8080
ENV ASPNETCORE_URLS=http://*:8080
ENV ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
ENV DOTNET_gcServer=1

# --- Build stage (SDK) ---
FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine@sha256:3cc3bbbbf93d82104892f42aa9106b6be4d120346dea0649643a97c801525256 AS build
WORKDIR /src

# Node exists ONLY to satisfy the csproj SpaServices target, which shells out to npm during publish.
# The ClientApp stub below makes that a no-op — nothing frontend is actually built in this image.
RUN apk add --no-cache nodejs npm

# Full repo context (T1.2) — shared projects (Database, Shared.Database) and root configs
# (.csharpierrc included) are guaranteed present. Hand-picked COPY lists break builds silently.
COPY . .

# Stub ClientApp so publish's PublishRunWebpack target skips the (separately-imaged) Angular build.
RUN rm -rf ./vsu-app/ClientApp && \
    mkdir -p ./vsu-app/ClientApp/dist/browser && \
    echo '{"name":"stub","scripts":{"build":"echo skip"}}' > ./vsu-app/ClientApp/package.json

# Compile. CSharpier is bypassed here — formatting is enforced in CI; the image build only compiles.
RUN dotnet restore "vsu-app/vsu-app.csproj"
RUN dotnet publish "vsu-app/vsu-app.csproj" -c Release -o /app/publish -p:CSharpier_Bypass=true

# --- Final runtime image ---
FROM base AS final
WORKDIR /app
RUN addgroup -S appgroup && adduser -S -G appgroup appuser
COPY --from=build /app/publish ./
RUN chown -R appuser:appgroup /app
USER appuser
ENTRYPOINT ["dotnet", "vsu-app.dll"]
