{
  "name": "vsu_app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.js",
    "build": "ng build",
    "builduat": "ng build --base-href /uat/vsuwebforms/ --deploy-url /uat/vsuwebforms/",
    "buildprod": "ng build --configuration=production",
    "watch": "ng build --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "ng lint",
    "format": "prettier --loglevel=warn --check \"./src/**/*.{js,jsx,ts,tsx,css,scss}\"",
    "format-fix": "prettier --loglevel=warn --write \"./src/**/*.{js,jsx,ts,tsx,json,css,scss}\"",
    "serve:ssr:vsu_app": "node dist/server/server.mjs",
    "generate:api": "orval --config orval.config.ts",
    "e2e": "playwright test --project=localhost",
    "e2e:dev": "playwright test --project=dev",
    "e2e:test": "playwright test --project=test",
    "e2e:test:headed": "playwright test --project=test --headed",
    "e2e:test:ui": "playwright test --project=test --ui",
    "e2e:report": "playwright show-report"
  },
  "private": true,
  "dependencies": {
    "@almothafar/angular-signature-pad": "^6.0.0",
    "@angular/animations": "21.2.19",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.24",
    "@angular/compiler": "21.2.24",
    "@angular/core": "21.2.24",
    "@angular/forms": "21.2.24",
    "@angular/material": "21.2.14",
    "@angular/material-moment-adapter": "21.2.14",
    "@angular/platform-browser": "21.2.24",
    "@angular/platform-browser-dynamic": "21.2.19",
    "@angular/platform-server": "21.2.24",
    "@angular/router": "21.2.24",
    "@angular/ssr": "21.2.24",
    "@ngrx/signals": "21.1.1",
    "bootstrap": "^5.3.8",
    "express": "^4.22.3",
    "moment": "^2.31.0",
    "ngx-bootstrap": "21.2.2",
    "ngx-mask": "21.1.0",
    "rxjs": "^7.8.2",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "21.2.24",
    "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.24",
    "@angular/language-service": "21.2.24",
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.17",
    "@types/node": "^25.9.8",
    "@vitest/ui": "^4.1.11",
    "jsdom": "^25.0.1",
    "mygovbc-bootstrap-theme": "^0.4.1",
    "orval": "^8.38.0",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.2.0",
    "typescript": "~5.9.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@hono/node-server": "2.0.12"
  }
}
